@ContactTogetherApi_HostAddress = http://localhost:5018

GET {{ContactTogetherApi_HostAddress}}/weatherforecast/
Accept: application/json

###

# Login - returns { statusCode, token, tokenType, expiresAtUtc, employeeId, userName, roleId }
# @name login
POST {{ContactTogetherApi_HostAddress}}/Auth/login
Content-Type: application/json

{
  "userName": "man",
  "password": "1234"
}

###

@token = {{login.response.body.token}}

# Add an employee - GenderId / RoleId / OrganizationId are ids from TblGender / TblRole /
# TblOrganization; the password is hashed (PBKDF2) before it is stored, and CreatedBy/UpdatedBy
# come from the token's sub claim.
POST {{ContactTogetherApi_HostAddress}}/UserManagement/employees
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userName": "adm_test",
  "password": "1234",
  "genderId": "C833A9E6D354B2AC350A50CFB41852A8",
  "salutationTh": "นาย",
  "firstnameTh": "ลาภิศ",
  "lastnameTh": "จิรปัณณการ",
  "firstnameEn": "Lapis",
  "lastnameEn": "Jirapannakarn",
  "contactDetail": "020000000",
  "position": "admin",
  "roleId": "1CE9D7882842E515C9292D42A3CC8E2F",
  "organizationId": "00E071487E1343B987C548DEDAE71387",
  "defaultLanguage": "T",
  "defaultRowPerPage": 100,
  "isEnable": "T"
}

###

# List of values - enabled channels as { id, nameTh }
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetChannel
Authorization: Bearer {{token}}

###

# List of values - enabled channels as { id, nameTh }
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetServiceType
Authorization: Bearer {{token}}

###


# Address dataset - every province / district / subdistrict for the three linked drop-downs.
# Returns { version, province[{id,name}], district[{id,provinceId,name}],
# subdistrict[{id,districtId,name,zipcode}] }. version changes only when the data does.
# Cached in server memory for 1 hour, sent br/gzip per Accept-Encoding, with
# Cache-Control: private, max-age=600 and a weak ETag W/"<version>".
# @name addressDataset
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetAddressDataset
Authorization: Bearer {{token}}
Accept-Encoding: br, gzip

###

# Same request with the ETag from above - 304 Not Modified, no body, while the data is unchanged
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetAddressDataset
Authorization: Bearer {{token}}
If-None-Match: {{addressDataset.response.headers.ETag}}

###

# Address, one level at a time (instead of GetAddressDataset). Only enabled rows; an unknown or
# disabled parent id gives []. A missing or non-numeric id gives 400 (ProblemDetails).
# Provinces - [{ id, name }]
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetProvince
Authorization: Bearer {{token}}

###

# The ids are the tables' own running numbers, not the DOPA codes (14 = เชียงใหม่ here, not 50).
# Districts of one province - [{ id, provinceId, name }]  (14 = เชียงใหม่)
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetDistrict?provinceId=14
Authorization: Bearer {{token}}

###

# Subdistricts of one district, each with its zipcode - [{ id, districtId, name, zipcode }]
# (218 = เมืองเชียงใหม่). The zipcode belongs to the subdistrict: 1 district in 5 has more than one
# (เมืองเชียงใหม่ has 50000/50100/50200/50300), so fill it in when a subdistrict is picked.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetSubdistrict?districtId=218
Authorization: Bearer {{token}}

###

# Genders - enabled TblGender rows as [{ id, nameTh, nameEn, isDefault }]. isDefault is "T"/"F";
# send id back as genderId when adding an account or an employee.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetGender
Authorization: Bearer {{token}}

###

# Roles - enabled TblRole rows as [{ id, nameTh, nameEn, levelSecretId, isDefault, isAdmin }].
# isDefault / isAdmin are "T"/"F"; levelSecretId is a TblLevel.Id. Send id back as roleId when
# adding an employee.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetRole
Authorization: Bearer {{token}}

###

# Call types (ประเภทการรับสาย) - the enabled TblCategory rows with CategoryType "CONTACT", as a tree
# of [{ id, nameTh, nameEn, children[] }]: group (Service / Non Service) > radio > drop-down.
# Save the id of the leaf the user picked as TblContact.CategoryId (the radio itself if it has no children).
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetContactType
Authorization: Bearer {{token}}

###

# Add an account (TblAccount only - phone numbers live in TblAccountDetail)
POST {{ContactTogetherApi_HostAddress}}/Account/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "salutationTh": "นางสาว",
  "firstnameTh": "ศิรประภา",
  "lastnameTh": "ทดสอบ",
  "genderId": "9CF68DA7874E672EFCA3A6F0824FE543",
  "address": "123 ถนนแจ้งวัฒนะ กรุงเทพฯ",
  "zipcode": "10210",
  "isScret": "F",
  "isEnable": "T"
}

###

# Look up accounts by phone number - matches MOBILE / HOME / OFFICE / FAX details
GET {{ContactTogetherApi_HostAddress}}/Account/by-phone?phoneNo=0908606424
Authorization: Bearer {{token}}

###

# Add a service (TblService). Code is generated: Buddhist yyMMdd + 5-digit daily running number
# (e.g. 69111100001). IsEnable is always "T"; OwnerId defaults to the token's employee and
# DateOpened to now. Every lookup id is optional but must exist when given (400 otherwise).
POST {{ContactTogetherApi_HostAddress}}/Services/AddNewService
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": "<TblCategory.Id>",
  "statusId": "332E6D76F258C8294B160C20642AB9F6",
  "accountId": "<TblAccount.Id>",
  "callBack": "N",
  "summary": "ทดสอบเปิดเรื่อง",
  "detail": "รายละเอียด"
}

###

# ---------------------------------------------------------------------------------------------
# AddNewContact - save the call-receiving form (รับสาย) as a TblContact row.
# channelId comes from GetChannel; categoryId is a leaf of GetContactType (the drop-down item, or
# the radio itself when it has none). ID, CreatedBy (token sub) and ContactEnd (now) are set by the
# server; contactStart is optional (Thai local time, no offset/Z, defaults to now).
# 201 = the saved row with channelNameTh / categoryNameTh.
#
# NOTE: every 201 case writes a real row. They all use contactDetail 0899999999 so the test rows can
# be found (and removed by hand) afterwards:
#   SELECT * FROM TblContact WHERE ContactDetail = '0899999999'
#
# Ids used below: channel Phone 332E6D76F258C8294B160C20642AB9F5, Facebook 332E6D76F258C8294B160C20642AB915.
# Call types: New Service ...A100011, Follow Up ...A100022, สายหลุด ...A200003,
# สัญญาณไม่ชัดเจน ...A200002, โทรเล่น > เด็กโทรเล่น ...A200013, โทรผิด > The Pizza Company ...A200017,
# Out of Scope > ขอคำปรึกษาเจ้าหน้าที่ ...A200006 (prefix 0168B738100C4CBAB9AA45906).
# ---------------------------------------------------------------------------------------------

# 201 - Service > New Service (a radio without a drop-down), with contactStart (any past time works)
POST {{ContactTogetherApi_HostAddress}}/Contact/AddNewContact
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contactDetail": "0899999999",
  "channelId": "332E6D76F258C8294B160C20642AB9F5",
  "categoryId": "0168B738100C4CBAB9AA45906A100011",
  "contactStart": "2026-11-11T10:15:00"
}

###

# 201 - Service > Follow Up, without contactStart (ContactStart = ContactEnd = now)
POST {{ContactTogetherApi_HostAddress}}/Contact/AddNewContact
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contactDetail": "0899999999",
  "channelId": "332E6D76F258C8294B160C20642AB9F5",
  "categoryId": "0168B738100C4CBAB9AA45906A100022"
}

###

# 201 - Non Service > สายหลุด (a radio without a drop-down)
POST {{ContactTogetherApi_HostAddress}}/Contact/AddNewContact
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contactDetail": "0899999999",
  "channelId": "332E6D76F258C8294B160C20642AB9F5",
  "categoryId": "0168B738100C4CBAB9AA45906A200003"
}

###

# 201 - Non Service > สัญญาณไม่ชัดเจน, spaces around the number are trimmed ("0899999999" is saved)
POST {{ContactTogetherApi_HostAddress}}/Contact/AddNewContact
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contactDetail": "  0899999999  ",
  "channelId": "332E6D76F258C8294B160C20642AB9F5",
  "categoryId": "0168B738100C4CBAB9AA45906A200002"
}

###

# 201 - Non Service > โทรเล่น > เด็กโทรเล่น (the drop-down item, not the radio)
POST {{ContactTogetherApi_HostAddress}}/Contact/AddNewContact
Authorization: Bearer {{token}}
Content-Type: application/json

