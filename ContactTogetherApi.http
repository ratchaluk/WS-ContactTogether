@ContactTogetherApi_HostAddress = http://localhost:5018

GET {{ContactTogetherApi_HostAddress}}/weatherforecast/
Accept: application/json

###

# Login - returns { statusCode, token, tokenType, expiresAtUtc, employeeId, userName, roleId }
# @name login
POST {{ContactTogetherApi_HostAddress}}/Auth/login
Content-Type: application/json

{
  "userName": "man",
  "password": "1234"
}

###

@token = {{login.response.body.token}}

# Add an employee - GenderId / RoleId / OrganizationId are ids from TblGender / TblRole /
# TblOrganization; the password is hashed (PBKDF2) before it is stored, and CreatedBy/UpdatedBy
# come from the token's sub claim.
POST {{ContactTogetherApi_HostAddress}}/UserManagement/employees
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userName": "adm_test",
  "password": "1234",
  "genderId": "C833A9E6D354B2AC350A50CFB41852A8",
  "salutationTh": "นาย",
  "firstnameTh": "ลาภิศ",
  "lastnameTh": "จิรปัณณการ",
  "firstnameEn": "Lapis",
  "lastnameEn": "Jirapannakarn",
  "contactDetail": "020000000",
  "position": "admin",
  "roleId": "1CE9D7882842E515C9292D42A3CC8E2F",
  "organizationId": "00E071487E1343B987C548DEDAE71387",
  "defaultLanguage": "T",
  "defaultRowPerPage": 100,
  "isEnable": "T"
}

###

# List of values - enabled channels as { id, nameTh }
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetChannel
Authorization: Bearer {{token}}

###

# List of values - enabled channels as { id, nameTh }
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetStatus
Authorization: Bearer {{token}}

###
# List of values - enabled channels as { id, nameTh }
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetServiceType
Authorization: Bearer {{token}}

###

# Service titles (TblServiceTitles, IsEnable = 'T') as [{ id, serviceTitleText }]. id is upper case,
# like TblService.ServiceTitleId. AddNewService requires one; SearchService can filter by one.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetServiceTitle
Authorization: Bearer {{token}}

###


# Address dataset - every province / district / subdistrict for the three linked drop-downs.
# Returns { version, province[{id,name}], district[{id,provinceId,name}],
# subdistrict[{id,districtId,name,zipcode}] }. version changes only when the data does.
# Cached in server memory for 1 hour, sent br/gzip per Accept-Encoding, with
# Cache-Control: private, max-age=600 and a weak ETag W/"<version>".
# @name addressDataset
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetAddressDataset
Authorization: Bearer {{token}}
Accept-Encoding: br, gzip

###

# Same request with the ETag from above - 304 Not Modified, no body, while the data is unchanged
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetAddressDataset
Authorization: Bearer {{token}}
If-None-Match: {{addressDataset.response.headers.ETag}}

###

# Address, one level at a time (instead of GetAddressDataset). Only enabled rows; an unknown or
# disabled parent id gives []. A missing or non-numeric id gives 400 (ProblemDetails).
# Provinces - [{ id, name }]
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetProvince
Authorization: Bearer {{token}}

###

# The ids are the tables' own running numbers, not the DOPA codes (14 = เชียงใหม่ here, not 50).
# Districts of one province - [{ id, provinceId, name }]  (14 = เชียงใหม่)
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetDistrict?provinceId=14
Authorization: Bearer {{token}}

###

# Subdistricts of one district, each with its zipcode - [{ id, districtId, name, zipcode }]
# (218 = เมืองเชียงใหม่). The zipcode belongs to the subdistrict: 1 district in 5 has more than one
# (เมืองเชียงใหม่ has 50000/50100/50200/50300), so fill it in when a subdistrict is picked.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetSubdistrict?districtId=218
Authorization: Bearer {{token}}

###

# Genders - enabled TblGender rows as [{ id, nameTh, nameEn, isDefault }]. isDefault is "T"/"F";
# send id back as genderId when adding an account or an employee.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetGender
Authorization: Bearer {{token}}

###

# Account detail types - fixed list (no table) as [{ id, nameTh }]: MOBILE, HOME, OFFICE, FAX, MAIL.
# Send id back as detailType when adding an account.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetAccountDetailType
Authorization: Bearer {{token}}

###

# Areas (TblArea) as [{ id, refId, nameTh, nameEn, areaType, zipcode, isDefault }], one level at a time.
# areaType (required) = PROVINCE | DISTRICT | SUBDISTRICT; refId (optional) = the parent's id.
# The "--ไม่ระบุ…--" row (isDefault "T") comes first. Send id back as areaId.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetArea?areaType=PROVINCE
Authorization: Bearer {{token}}

###

# Districts of นครนายก, then sub-districts of อำเภอเมืองนครนายก.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetArea?areaType=DISTRICT&refId=81DEE3BDDF62528B9DEB9C1C6D74CEC4
Authorization: Bearer {{token}}

###

GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetArea?areaType=SUBDISTRICT&refId=49B4AB5B3D754BA2883582DDAB76AF46
Authorization: Bearer {{token}}

###

# References (ที่มาข้อมูล) - enabled TblReference rows as [{ id, nameTh, nameEn, isDefault }].
# Send id back as serviceReference when adding a service.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetReference
Authorization: Bearer {{token}}

###

# Levels - enabled TblLevel rows of one type as [{ id, nameTh, nameEn, multiplier, isDefault }],
# sorted by multiplier. levelType is SEVERITY (send id as levelSeverityId), PRIORITY (levelPriorityId)
# or SECRET (levelSecretId) when adding a service.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetLevel?levelType=SEVERITY
Authorization: Bearer {{token}}

###

GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetLevel?levelType=PRIORITY
Authorization: Bearer {{token}}

###

GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetLevel?levelType=SECRET
Authorization: Bearer {{token}}

###

# Unknown or missing levelType -> 400 ProblemDetails (errors.levelType)
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetLevel?levelType=xxx
Authorization: Bearer {{token}}

###

# Statuses for the add-service form - no query = every enabled StatusType SERVICE row (14), sorted by
# nameTh, as [{ id, refId, nameTh, nameEn, isType, isDefault }]. Send the chosen id as statusId.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetStatus
Authorization: Bearer {{token}}

###

# Work-log (TblActivity) statuses: [เปิด, ปิด, ยกเลิก]. Not accepted by AddNewService (400).
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetStatus?statusType=SERVICE
Authorization: Bearer {{token}}

###

# Unknown statusType -> 400 ProblemDetails (errors.statusType)
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetStatus?statusType=ACTIVITY
Authorization: Bearer {{token}}

###

# Activity (work-log) statuses only: StatusType = ACTIVITY, enabled, ordered by NameTh.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetStatusByStatusTypeActivity
Authorization: Bearer {{token}}

###

# Organizations - every enabled TblOrganization row (395), sorted by nameTh, as [{ id, refId, nameTh, nameEn }].
# Two levels: a ministry (กระทรวง) has refId == id (22 rows), a department (กรม) has refId = its ministry.
# Send the department id as organizationId when adding a service.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetOrganization
Authorization: Bearer {{token}}

###

# Roles - enabled TblRole rows as [{ id, nameTh, nameEn, levelSecretId, isDefault, isAdmin }].
# isDefault / isAdmin are "T"/"F"; levelSecretId is a TblLevel.Id. Send id back as roleId when
# adding an employee.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetRole
Authorization: Bearer {{token}}

###

# Employees - enabled TblEmployee rows as [{ id, nameTh }] (nameTh = salutation + first + last name).
# Send id as serviceOwner to SearchService. No password or personal data is returned.
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetEmployee
Authorization: Bearer {{token}}

###

# Call types (ประเภทการรับสาย) - the enabled TblCategory rows with CategoryType "CONTACT", as a tree
# of [{ id, nameTh, nameEn, children[] }]: group (Service / Non Service) > radio > drop-down.
# Save the id of the leaf the user picked as TblContact.CategoryId (the radio itself if it has no children).
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/GetContactType
Authorization: Bearer {{token}}

###

# Add an account (TblAccount). contacts is optional (max 10): each item saves a TblAccountDetail row
# (AccountId = the new account's Id), in the same transaction. detailType is MOBILE (default),
# HOME, OFFICE, FAX or MAIL; anything else is 400. The 201 response lists them under contacts.
POST {{ContactTogetherApi_HostAddress}}/Account/AddNewAccount
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "salutationTh": "นางสาว",
  "firstnameTh": "ศิรประภา",
  "lastnameTh": "ทดสอบ",
  "genderId": "9CF68DA7874E672EFCA3A6F0824FE543",
  "address": "123 ถนนแจ้งวัฒนะ กรุงเทพฯ",
  "zipcode": "10210",
  "isScret": "F",
  "isEnable": "T",
  "contacts": [
    { "detailType": "MOBILE", "detail": "0812345678" },
    { "detailType": "MAIL", "detail": "sirapa@example.com" }
  ]
}

###

# Add one phone number / e-mail to an account (WRITES TO THE DATABASE). 201 returns the account with
# all enabled contacts (each has an id). 409 if the same type + value already exists, 400 at 10 contacts.
POST {{ContactTogetherApi_HostAddress}}/Account/AddAccountDetail?accountId=5BAAE3446A7E456697166D7A59EE7558
Authorization: Bearer {{token}}
Content-Type: application/json

{ "detailType": "HOME", "detail": "021234567" }

###

# Change one contact (WRITES TO THE DATABASE). id = contacts[].id from GetAccountById.
PUT {{ContactTogetherApi_HostAddress}}/Account/UpdateAccountDetail?id=<contacts[].id>
Authorization: Bearer {{token}}
Content-Type: application/json

{ "detailType": "OFFICE", "detail": "027654321" }

###

# Disable one contact (WRITES TO THE DATABASE): IsEnable = F, the row is kept. A second call is 404.
DELETE {{ContactTogetherApi_HostAddress}}/Account/DeleteAccountDetail?id=<contacts[].id>
Authorization: Bearer {{token}}

###

# Look up accounts by phone number - matches MOBILE / HOME / OFFICE / FAX details
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccountByPhoneNo?phoneNo=0908606424
Authorization: Bearer {{token}}

###
# Look up accounts by phone number - matches MOBILE / HOME / OFFICE / FAX details
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccountByPhoneNo?phoneNo=0934153694
Authorization: Bearer {{token}}

###


# ---------------------------------------------------------------------------------------------
# GetAccounts - search accounts by partial firstName / lastName (Thai or English) and/or contactInfo
# (address or any enabled phone / e-mail). At least one is required; every one given must match.
# 200 = array of at most 100 accounts (no total, no paging), each with its id and contacts[].
# Matching is case-sensitive. Thai text in the URL is percent-encoded (UTF-8) below.
# ---------------------------------------------------------------------------------------------

# 200 - by phone number (8 accounts). Use this, not GetAccountByPhoneNo, when you need the account id.
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccounts?contactInfo=0909840822
Authorization: Bearer {{token}}

###

# 200 - by part of a phone number
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccounts?contactInfo=090984
Authorization: Bearer {{token}}

###

# 200 - by e-mail domain (matches any e-mail containing the text)
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccounts?contactInfo=@gmail.com
Authorization: Bearer {{token}}

###

# 200 - firstName "สม" (465 matches in the DB, so the result stops at 100)
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccounts?firstName=%E0%B8%AA%E0%B8%A1
Authorization: Bearer {{token}}

###

# 200 - firstName "สม" AND lastName "ใจ"
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccounts?firstName=%E0%B8%AA%E0%B8%A1&lastName=%E0%B9%83%E0%B8%88
Authorization: Bearer {{token}}

###

# 200 - firstName in English (case-sensitive: "somchai" does not match "Somchai")
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccounts?firstName=Som
Authorization: Bearer {{token}}

###

# 400 - no filter at all
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccounts
Authorization: Bearer {{token}}

###

# 400 - filters that are blank after trimming count as not given
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccounts?firstName=%20%20&contactInfo=
Authorization: Bearer {{token}}

###

# 401 - no token
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccounts?contactInfo=0909840822

###

# One account by TblAccount.Id (accountId of a service), shaped like a GetAccounts row: names,
# gender, address, contacts. Disabled accounts are returned too. 400 = no id; 404 = no such account.
GET {{ContactTogetherApi_HostAddress}}/Account/GetAccountById?id=F05AB03D7CF74CEFA75504047FD52343
Authorization: Bearer {{token}}

###

# Replace an account's columns (send the whole account: a field left out becomes null). Phones and
# e-mails (TblAccountDetail) are not changed. Keeping the account's current areaId is allowed even
# though TblArea is empty. 200 = the account as GetAccountById returns it; 400; 404.
# WRITES TO THE DATABASE.
PUT {{ContactTogetherApi_HostAddress}}/Account/UpdateAccountById?id=4D7B3F5E81104F349449B50571E72BCE
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "salutationTh": "นาย",
  "firstnameTh": "อินดี้",
  "lastnameTh": "ทดสอบจ้า",
  "salutationEn": "",
  "firstnameEn": "",
  "lastnameEn": "",
  "genderId": "19C49E66B6F9EF1BCE11A3B93DED12C4",
  "birthdate": "",
  "address": "",
  "areaId": "",
  "zipcode": "10210",
  "remark": "",
  "isScret": "F",
  "isEnable": "T"
}

###

# Add a service (TblService). Code is generated: Buddhist yyMMdd + 5-digit daily running number
# (e.g. 69111100001). IsEnable is always "T"; OwnerId defaults to the token's employee and
# DateOpened to now. Every lookup id is optional but must exist when given (400 otherwise).
# statusId is any StatusType SERVICE id from GetStatus, stored as sent
# (e.g. อยู่ระหว่างดำเนินการ 19C49E66B6F9EF1BCE11A3B93DED12C8).
# NOTE: a 201 writes a real row and uses up one service code of the day.
POST {{ContactTogetherApi_HostAddress}}/Services/AddNewService
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": "<TblCategory.Id>",
  "statusId": "19C49E66B6F9EF1BCE11A3B93DED12C8",
  "serviceTitleId": "81EE380A-96E2-F111-8E93-96F1F7A12F5E",
  "accountId": "<TblAccount.Id>",
  "callBack": "N",
  "summary": "ทดสอบเปิดเรื่อง",
  "detail": "รายละเอียด"
}

###

# 400 - an ACTIVITY status (ปิด) is not a service status: errors.StatusId. Nothing is written.
POST {{ContactTogetherApi_HostAddress}}/Services/AddNewService
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "statusId": "CB0A973609E8D684F2944D92ED4126A1",
  "summary": "ทดสอบสถานะผิดประเภท"
}

###

# Search services (was GetServices). At least one filter is required (AccountId, AccountPhoneNo, ServicesStatus,
# ServiceCode, ServiceSummary, ServiceType, ServiceTitleId, ServiceReference, LevelPriorityId,
# ServiceOwner, OrganizationGroup, Organization, ServiceCreatedFrom/To).
# SortOrder = desc (newest first, default) | asc (oldest first). PageNumber (default 1) /
# PageSize (default 20, max 200) pick the page.
# 200 = { status, message, data, meta.pagination { current_page, per_page, total, total_pages } }.
GET {{ContactTogetherApi_HostAddress}}/Services/SearchService?AccountPhoneNo=0909840822&PageNumber=1&PageSize=10
Authorization: Bearer {{token}}

###

# Search services (was GetServices). At least one filter is required (AccountId, AccountPhoneNo, ServicesStatus,
# ServiceCode, ServiceSummary, ServiceType, ServiceTitleId, ServiceReference, LevelPriorityId,
# ServiceOwner, OrganizationGroup, Organization, ServiceCreatedFrom/To).
# SortOrder = desc (newest first, default) | asc (oldest first). PageNumber (default 1) /
# PageSize (default 20, max 200) pick the page.
# 200 = { status, message, data, meta.pagination { current_page, per_page, total, total_pages } }.
GET {{ContactTogetherApi_HostAddress}}/Services/SearchService?AccountPhoneNo=0934153694&PageNumber=1&PageSize=10
Authorization: Bearer {{token}}

###

# Services of one chosen account only (AccountId = TblAccount.Id). 0934153694 belongs to two accounts,
# so searching by the number above returns both; this returns นาย อาม's service only.
GET {{ContactTogetherApi_HostAddress}}/Services/SearchService?AccountId=5A15B0A6398344718D6473C1B7DFB7CA&PageNumber=1&PageSize=10
Authorization: Bearer {{token}}

###

# Search by data source (ServiceReference = TblReference.Id from GetReference, here Joomla), oldest first.
GET {{ContactTogetherApi_HostAddress}}/Services/SearchService?ServiceReference=0199D0ECBE0F08A02BDFDB8460CAB362&SortOrder=asc&PageNumber=1&PageSize=10
Authorization: Bearer {{token}}

###

# Search by priority (LevelPriorityId = TblLevel.Id from GetLevel?levelType=PRIORITY, here 3-Medium), newest first.
GET {{ContactTogetherApi_HostAddress}}/Services/SearchService?LevelPriorityId=D550B0AAB78CEEE3E6C027E477932A35&SortOrder=desc&PageNumber=1&PageSize=10
Authorization: Bearer {{token}}

###

# One service for the detail page, by TblService.Id (serviceId of SearchService, id of AddNewService).
# 200 = every id of AddNewService's response plus their names, categoryPath / organizationPath
# (top level first), account (the whole TblAccount row with gender and contacts, or null),
# reOpenHistory (TblReOpenService rows by Line: comment, closed/reopened times, ids and names; [] if never);
# 400 = no id; 404 = no enabled service with that id.
GET {{ContactTogetherApi_HostAddress}}/Services/GetServiceById?id=427D66AA13734763AC1D99775554659B
Authorization: Bearer {{token}}

###

# Update a service - only the fields sent change; "" clears a text field. Updated/UpdatedBy come from
# the clock and the token. 200 = the service (same shape as AddNewService); 400 = no id or a bad lookup
# id; 404 = no enabled service with that id.
PUT {{ContactTogetherApi_HostAddress}}/Services/UpdateService?id=427D66AA13734763AC1D99775554659B
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "summary": "แก้ไขสรุปเรื่อง",
  "remark": "หมายเหตุใหม่"
}

###

# Close - a CLOSE/CANCEL status (ปิดเรื่อง 67F7...) sets DateClosed to now when it is not sent (send
# dateClosed to backdate it: not in the future, not before dateOpened). dateClosed with any other
# status = 400.
PUT {{ContactTogetherApi_HostAddress}}/Services/UpdateService?id=427D66AA13734763AC1D99775554659B
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "statusId": "67F7D634C1D74FDE512C164D6A2A1EF9"
}

###

# Reopen - an OPEN status (เปิดเรื่อง 60CD...) sent for a service whose DateClosed is set adds a
# TblReOpenService row (Line = the service's last Line + 1, from 1), with reOpenComment (max 100), and
# clears DateClosed. All in one transaction. Pending (isType PENDING) does not reopen.
PUT {{ContactTogetherApi_HostAddress}}/Services/UpdateService?id=427D66AA13734763AC1D99775554659B
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "statusId": "60CD725EA4455BA6770FC94BC78F466F",
  "reOpenComment": "ผู้ร้องแจ้งว่าปัญหายังไม่ได้รับการแก้ไข"
}

###

# Add an operation (TblActivity row) to a service. Line = the service's last Line + 1 (from 1); Code =
# yyMMdd (B.E.) + a 5-digit daily running number, counted separately from service codes. statusId is an
# ACTIVITY status (Open 0A57...04 / Closed CB0A...A1 / Cancel CD64...62). Omitted: categoryId = the
# service's, ownerId = the caller, isReceived = "F", dateOpened = now. 201 = the row; 400 = bad input;
# 404 = no enabled service with that id.
POST {{ContactTogetherApi_HostAddress}}/Services/AddNewServiceOperations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "serviceId": "427D66AA13734763AC1D99775554659B",
  "statusId": "0A5753389CDCD23F173268D8D46AC004",
  "summary": "โทรติดต่อผู้ร้องเพื่อสอบถามข้อมูลเพิ่มเติม",
  "detail": "ผู้ร้องจะส่งเอกสารเพิ่มเติมภายในวันพรุ่งนี้"
}

###

# Edit an operation by its TblActivity.Id (the "id" AddNewServiceOperations returns). Only the fields sent
# change; "" clears a nullable field (detail, contactId, ownerId, groupId) and is ignored for statusId,
# summary, categoryId and isReceived. ServiceId, Line and Code cannot change. 200 = the row; 400 = a bad
# id or lookup; 404 = no enabled operation with that id.
PUT {{ContactTogetherApi_HostAddress}}/Services/UpdateServiceOperations?id=00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "statusId": "CB0A973609E8D684F2944D92ED4126A1",
  "dateClosed": "2026-11-23T16:30:00",
  "detail": "ได้รับเอกสารครบแล้ว ปิดงาน"
}

###


# ---------------------------------------------------------------------------------------------
# AddNewContact - save the call-receiving form (รับสาย) as a TblContact row.
# channelId comes from GetChannel; categoryId is a leaf of GetContactType (the drop-down item, or
# the radio itself when it has none). ID, CreatedBy (token sub) and ContactEnd (now) are set by the
# server; contactStart is optional (Thai local time, no offset/Z, defaults to now).
# 201 = the saved row with channelNameTh / categoryNameTh.
#
# NOTE: every 201 case writes a real row. They all use contactDetail 0899999999 so the test rows can
# be found (and removed by hand) afterwards:
#   SELECT * FROM TblContact WHERE ContactDetail = '0899999999'
#
# Ids used below: channel Phone 332E6D76F258C8294B160C20642AB9F5, Facebook 332E6D76F258C8294B160C20642AB915.
# Call types: New Service ...A100011, Follow Up ...A100022, สายหลุด ...A200003,
# สัญญาณไม่ชัดเจน ...A200002, โทรเล่น > เด็กโทรเล่น ...A200013, โทรผิด > The Pizza Company ...A200017,
# Out of Scope > ขอคำปรึกษาเจ้าหน้าที่ ...A200006 (prefix 0168B738100C4CBAB9AA45906).
# ---------------------------------------------------------------------------------------------

# 201 - Service > New Service (a radio without a drop-down), with contactStart (any past time works)
POST {{ContactTogetherApi_HostAddress}}/Contact/AddNewContact
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contactDetail": "0899999999",
  "channelId": "332E6D76F258C8294B160C20642AB9F5",
  "categoryId": "0168B738100C4CBAB9AA45906A100011",
  "contactStart": "2026-11-11T10:15:00"
}

###

# 201 - Service > Follow Up, without contactStart (ContactStart = ContactEnd = now)
POST {{ContactTogetherApi_HostAddress}}/Contact/AddNewContact
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contactDetail": "0899999999",
  "channelId": "332E6D76F258C8294B160C20642AB9F5",
  "categoryId": "0168B738100C4CBAB9AA45906A100022"
}

###

# 201 - Non Service > สายหลุด (a radio without a drop-down)
POST {{ContactTogetherApi_HostAddress}}/Contact/AddNewContact
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contactDetail": "0899999999",
  "channelId": "332E6D76F258C8294B160C20642AB9F5",
  "categoryId": "0168B738100C4CBAB9AA45906A200003"
}

###

# 201 - Non Service > สัญญาณไม่ชัดเจน, spaces around the number are trimmed ("0899999999" is saved)
POST {{ContactTogetherApi_HostAddress}}/Contact/AddNewContact
Authorization: Bearer {{token}}
Content-Type: application/json

{
