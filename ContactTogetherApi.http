@ContactTogetherApi_HostAddress = http://localhost:5018

GET {{ContactTogetherApi_HostAddress}}/weatherforecast/
Accept: application/json

###

# Login - returns { statusCode, token, tokenType, expiresAtUtc, employeeId, userName, roleId }
# @name login
POST {{ContactTogetherApi_HostAddress}}/Auth/login
Content-Type: application/json

{
  "userName": "admin",
  "password": "P@ssw0rd!"
}

###

@token = {{login.response.body.token}}

# Add an employee - GenderId / RoleId / OrganizationId are ids from TblGender / TblRole /
# TblOrganization; the password is hashed (PBKDF2) before it is stored, and CreatedBy/UpdatedBy
# come from the token's sub claim.
POST {{ContactTogetherApi_HostAddress}}/UserManagement/employees
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userName": "adm_test",
  "password": "1234",
  "genderId": "C833A9E6D354B2AC350A50CFB41852A8",
  "salutationTh": "นาย",
  "firstnameTh": "ลาภิศ",
  "lastnameTh": "จิรปัณณการ",
  "firstnameEn": "Lapis",
  "lastnameEn": "Jirapannakarn",
  "contactDetail": "020000000",
  "position": "admin",
  "roleId": "1CE9D7882842E515C9292D42A3CC8E2F",
  "organizationId": "00E071487E1343B987C548DEDAE71387",
  "defaultLanguage": "T",
  "defaultRowPerPage": 100,
  "isEnable": "T"
}

###

# List of values - enabled channels as { id, nameTh }
GET {{ContactTogetherApi_HostAddress}}/ListOfValues/channels
Authorization: Bearer {{token}}

###

# Add an account (TblAccount only - phone numbers live in TblAccountDetail)
POST {{ContactTogetherApi_HostAddress}}/Account/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "salutationTh": "นางสาว",
  "firstnameTh": "ศิรประภา",
  "lastnameTh": "ทดสอบ",
  "genderId": "9CF68DA7874E672EFCA3A6F0824FE543",
  "address": "123 ถนนแจ้งวัฒนะ กรุงเทพฯ",
  "zipcode": "10210",
  "isScret": "F",
  "isEnable": "T"
}

###

# Look up accounts by phone number - matches MOBILE / HOME / OFFICE / FAX details
GET {{ContactTogetherApi_HostAddress}}/Account/by-phone?phoneNo=0908606424
Authorization: Bearer {{token}}

###

# Report 01 - every response is wrapped in _0BaseReturn { callAPIStatus, callAPIStatusMessage, result }.
# P_Start / P_Finish are ISO 8601 Thai local date-times, yyyy-MM-ddTHH:mm:ss (seconds optional,
# no offset or Z). Both ends are inclusive.
# 200 - rows found, or an empty result with "ไม่พบข้อมูล"
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport01
Content-Type: application/json

{
  "p_Start": "2026-07-01T08:00:00",
  "p_Finish": "2026-07-31T17:00:00"
}

###

# 400 - P_Start missing
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport01
Content-Type: application/json

{
  "p_Finish": "2026-07-31T23:59:59"
}

###

# 400 - no time part (the time is required)
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport01
Content-Type: application/json

{
  "p_Start": "2026-07-01",
  "p_Finish": "2026-07-31"
}

###

# 400 - old MM/dd/yyyy format is no longer accepted by Report 01
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport01
Content-Type: application/json

{
  "p_Start": "07/01/2026",
  "p_Finish": "07/31/2026"
}

###

# 400 - P_Start after P_Finish
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport01
Content-Type: application/json

{
  "p_Start": "2026-08-01T00:00:00",
  "p_Finish": "2026-07-01T00:00:00"
}

###

# 400 - malformed JSON still answers with _0BaseReturn, not ProblemDetails
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport01
Content-Type: application/json

{
  "p_Start": "2026-07-01T00:00:00",

###

# Report 02 - service requests with CallBack = "D"; same ISO 8601 request rules and _0BaseReturn
# envelope as Report 01
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport02
Content-Type: application/json

{
  "p_Start": "2026-01-01T00:00:00",
  "p_Finish": "2026-12-31T23:59:59"
}

###

# Report 03 - service requests with CallBack = "Y"; same ISO 8601 request rules as Report 01
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport03
Content-Type: application/json

{
  "p_Start": "2026-01-01T00:00:00",
  "p_Finish": "2026-12-31T23:59:59"
}

###

# Report 04 - service requests of a main organization and all of its sub-organizations.
# Same ISO 8601 date rules as Report 01; P_MainOrg (TblOrganization.Id) is required.
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport04
Content-Type: application/json

{
  "p_Start": "2026-01-01T00:00:00",
  "p_Finish": "2026-12-31T23:59:59",
  "p_MainOrg": "00D1DA8C956043D5AD9B38299566A7F0"
}

###

# 400 - P_MainOrg missing
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport04
Content-Type: application/json

{
  "p_Start": "2026-01-01T00:00:00",
  "p_Finish": "2026-12-31T23:59:59"
}

###

# Report 05 - contact counts per day by the claim teams (groups 53/77), from TblContact.ContactStart.
# Same ISO 8601 request as Report 01, but only the date part is used (ContactStart holds dates only).
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport05
Content-Type: application/json

{
  "p_Start": "2014-01-01T00:00:00",
  "p_Finish": "2014-12-31T23:59:59"
}

###

# Report 06 - contact counts per day by creators in none of the groups 53/77 (claim, Report 05),
# 79 (1212) or 68 (training). Same request as Report 05; only the date part is used.
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport06
Content-Type: application/json

{
  "p_Start": "2014-01-01T00:00:00",
  "p_Finish": "2014-12-31T23:59:59"
}

###

# Report 07 - service requests of one service type. Same ISO 8601 date rules as Report 01;
# P_Service (top-level TblCategory.Id, e.g. Q&A below) is required.
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport07
Content-Type: application/json

{
  "p_Start": "2026-01-01T00:00:00",
  "p_Finish": "2026-12-31T23:59:59",
  "p_Service": "0168B738100C4CBAB9AA45906AD4D8E5"
}

###

# 400 - P_Service missing
POST {{ContactTogetherApi_HostAddress}}/Report/GetReport07
Content-Type: application/json

{
  "p_Start": "2026-01-01T00:00:00",
  "p_Finish": "2026-12-31T23:59:59"
}

###

# Logout - revokes the presented token for the remainder of its lifetime
POST {{ContactTogetherApi_HostAddress}}/Auth/logout
Authorization: Bearer {{token}}

###
